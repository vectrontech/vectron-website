---
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogWidth?: number;
  ogHeight?: number;
  noindex?: boolean;
  robots?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  path,
  ogImage = "/og.jpg",
  ogWidth = 1200,
  ogHeight = 630,
  noindex = false,
  robots,
  ogType = "website",
} = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const absoluteOg = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Vectron Technologies" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <meta name="theme-color" content="#050505" />
    <link rel="preload" href="/assets/fonts/space-grotesk-latin-wght-normal.BhU9QXUp.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.Dx4kXJAl.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css?v=17" />
    <link rel="stylesheet" href="/blog/post.css" />
  </head>
  <body>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
