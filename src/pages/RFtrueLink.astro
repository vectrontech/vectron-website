<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>

<script is:inline>
/* =====================================================================
   RFTrueLink subpage — hero animation + interactions.
   Wrapped in an IIFE so it can be loaded multiple times safely.
   ===================================================================== */
(function () {
  /* ---- Hero spectrum + waveform canvas animation ---- */
  const canvas = document.getElementById("rftlHeroCanvas");
  if (canvas && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const ctx = canvas.getContext("2d", { alpha: true });
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    let cw = 0, ch = 0;
    function resize() {
      const rect = canvas.getBoundingClientRect();
      const w = Math.max(1, Math.floor(rect.width  * dpr));
      const h = Math.max(1, Math.floor(rect.height * dpr));
      if (canvas.width  !== w) canvas.width  = w;
      if (canvas.height !== h) canvas.height = h;
      cw = w; ch = h;
    }
    requestAnimationFrame(() => { resize(); requestAnimationFrame(resize); });
    window.addEventListener("load", resize, { once: true });
    window.addEventListener("resize", resize, { passive: true });
    if (typeof ResizeObserver === "function") new ResizeObserver(resize).observe(canvas);

    const AMBER   = "rgba(245, 165, 36, ";
    const AMBER_H = "rgba(255, 193, 92, ";
    const CYAN    = "rgba(96, 176, 240, ";
    const WHITE   = "rgba(255, 255, 255, ";

    const BAR_COUNT = 96;
    const bars = new Array(BAR_COUNT).fill(0).map(() => ({
      phase: Math.random() * Math.PI * 2,
      freq:  0.6 + Math.random() * 1.4,
      base:  0.15 + Math.random() * 0.45,
      peak:  0.45 + Math.random() * 0.55,
    }));
    const PARTICLE_COUNT = 28;
    const particles = new Array(PARTICLE_COUNT).fill(0).map(() => ({
      x: Math.random(), y: Math.random(),
      r: 0.6 + Math.random() * 1.4,
      vx: (Math.random() - 0.5) * 0.012,
      vy: (Math.random() - 0.5) * 0.006,
      alpha: 0.2 + Math.random() * 0.4,
    }));

    function waveY(x01, t, conf) {
      return (
        conf.A1 * Math.sin(conf.k1 * x01 * Math.PI * 2 + conf.p1 * t) +
        conf.A2 * Math.sin(conf.k2 * x01 * Math.PI * 2 + conf.p2 * t) +
        conf.A3 * Math.sin(conf.k3 * x01 * Math.PI * 2 + conf.p3 * t)
      );
    }
    const WAVE_A = { A1: 0.55, A2: 0.30, A3: 0.18,
                     k1: 1.4,  k2: 3.1,  k3: 6.7,
                     p1: 0.45, p2: 0.7,  p3: 1.2 };
    const WAVE_B = { A1: 0.40, A2: 0.22, A3: 0.10,
                     k1: 0.9,  k2: 2.2,  k3: 5.3,
                     p1: 0.30, p2: 0.55, p3: 0.9 };

    let visible = true;
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        for (const e of entries) visible = e.isIntersecting;
      }, { threshold: 0 }).observe(canvas);
    }

    let scrollFade = 1;
    function updateScrollFade() {
      const hero = document.querySelector(".rftl-page .hero");
      if (!hero) return;
      const r = hero.getBoundingClientRect();
      const total = r.height || 1;
      const passed = Math.min(Math.max(-r.top / total, 0), 1);
      scrollFade = 1 - passed * 0.85;
    }
    window.addEventListener("scroll", updateScrollFade, { passive: true });
    updateScrollFade();

    function drawGraticule() {
      const lines = 8;
      ctx.save();
      ctx.strokeStyle = WHITE + "0.04)";
      ctx.lineWidth = 1;
      for (let i = 1; i < lines; i++) {
        const y = (ch / lines) * i;
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(cw, y); ctx.stroke();
      }
      ctx.strokeStyle = WHITE + "0.06)";
      ctx.beginPath(); ctx.moveTo(0, ch / 2); ctx.lineTo(cw, ch / 2); ctx.stroke();
      ctx.restore();
    }
    function drawSpectrum(t) {
      const baseline = ch * 0.92;
      const maxH = ch * 0.55;
      const bw = cw / BAR_COUNT;
      ctx.save();
      for (let i = 0; i < BAR_COUNT; i++) {
        const b = bars[i];
        const level = b.base + (b.peak - b.base) *
          (0.5 + 0.5 * Math.sin(b.phase + t * b.freq * 0.8));
        const h = level * maxH;
        const x = i * bw;
        const grad = ctx.createLinearGradient(0, baseline - h, 0, baseline);
        grad.addColorStop(0,   AMBER_H + "0)");
        grad.addColorStop(0.5, AMBER + (0.18 * scrollFade) + ")");
        grad.addColorStop(1,   AMBER + (0.05 * scrollFade) + ")");
        ctx.fillStyle = grad;
        ctx.fillRect(x + bw * 0.18, baseline - h, bw * 0.64, h);
      }
      ctx.restore();
    }
    function drawWave(t, conf, hue, amp, yFrac, glow) {
      const steps = Math.max(80, Math.floor(cw / 6));
      const midY = ch * yFrac;
      const ampPx = amp * ch * 0.18 * scrollFade;
      ctx.save();
      ctx.shadowColor = hue + "0.85)";
      ctx.shadowBlur = glow * dpr;
      ctx.strokeStyle = hue + (0.85 * scrollFade) + ")";
      ctx.lineWidth = 1.6 * dpr;
      ctx.lineJoin = "round";
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const x01 = i / steps;
        const x = x01 * cw;
        const y = midY + waveY(x01, t, conf) * ampPx;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = hue + (Math.min(1, 1.0 * scrollFade)) + ")";
      ctx.lineWidth = 1.0 * dpr;
      ctx.stroke();
      ctx.restore();
    }
    function drawParticles() {
      ctx.save();
      for (const p of particles) {
        p.x += p.vx * 0.02;
        p.y += p.vy * 0.02;
        if (p.x < 0) p.x += 1; else if (p.x > 1) p.x -= 1;
        if (p.y < 0) p.y += 1; else if (p.y > 1) p.y -= 1;
        ctx.fillStyle = WHITE + (p.alpha * scrollFade * 0.6) + ")";
        ctx.beginPath();
        ctx.arc(p.x * cw, p.y * ch, p.r * dpr, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    let last = performance.now();
    let timeS = 0;
    function tick(now) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      requestAnimationFrame(tick);
      if (!visible || cw === 0) return;
      timeS += dt;
      ctx.clearRect(0, 0, cw, ch);
      drawGraticule();
      drawSpectrum(timeS);
      drawWave(timeS, WAVE_B, CYAN,  0.85, 0.50, 18);
      drawWave(timeS, WAVE_A, AMBER, 1.00, 0.50, 22);
      drawParticles();
    }
    requestAnimationFrame(tick);
  }

  /* ---- GSAP ScrollTrigger: headline parallax + reveals ---- */
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    (function waitGsap() {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") {
        return setTimeout(waitGsap, 50);
      }
      gsap.registerPlugin(ScrollTrigger);
      const heroContent = document.querySelector(".rftl-page .hero__content");
      if (heroContent) {
        gsap.to(heroContent, {
          ease: "none", y: 60, opacity: 0.85,
          scrollTrigger: {
            trigger: ".rftl-page .hero",
            start: "top top",
            end: "bottom top",
            scrub: 0.6,
          },
        });
      }
      document.querySelectorAll(".rftl-page [data-reveal]").forEach((el) => {
        ScrollTrigger.create({
          trigger: el, start: "top 88%", once: true,
          onEnter: () => el.classList.add("is-visible"),
        });
      });
    })();
  }

  /* Reveal fallback if GSAP never loads */
  setTimeout(() => {
    if (typeof gsap === "undefined") {
      document.querySelectorAll(".rftl-page [data-reveal]")
        .forEach((el) => el.classList.add("is-visible"));
    }
  }, 800);

  /* ---- Tabs (screenshot gallery) ---- */
  document.querySelectorAll(".rftl-page [data-tabs]").forEach((root) => {
    const tabs = root.querySelectorAll('[role="tab"]');
    const panels = root.querySelectorAll('[role="tabpanel"]');
    function activate(tab) {
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.setAttribute("tabindex", on ? "0" : "-1");
      });
      const target = tab.getAttribute("aria-controls");
      panels.forEach((p) => {
        const on = p.id === target;
        p.classList.toggle("is-active", on);
        if (on) p.removeAttribute("hidden"); else p.setAttribute("hidden", "");
      });
    }
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const list = Array.from(tabs);
        const i = list.indexOf(tab);
        const next = e.key === "ArrowRight"
          ? list[(i + 1) % list.length]
          : list[(i - 1 + list.length) % list.length];
        next.focus(); activate(next);
      });
    });
  });

  /* ---- Pricing + download stubs (mailto fallback) ---- */
  const CHECKOUT_URLS = {
    // personal:   "https://gumroad.com/l/rftruelink-personal",
    // enterprise: "https://gumroad.com/l/rftruelink-enterprise",
  };
  const FALLBACK_MAILTO =
    "mailto:info@vectrontechnologies.com?subject=RFTrueLink%20purchase%20interest";
  document.querySelectorAll(".rftl-page [data-plan]").forEach((el) => {
    el.addEventListener("click", (e) => {
      const plan = el.dataset.plan;
      const url = CHECKOUT_URLS[plan];
      if (url) {
        el.setAttribute("href", url);
        el.setAttribute("target", "_blank");
        el.setAttribute("rel", "noopener");
        return;
      }
      if (plan === "perpetual") return;
      e.preventDefault();
      window.location.href = FALLBACK_MAILTO +
        "%20(" + encodeURIComponent(plan) + ")";
    });
  });
  const TRIAL_URLS = {
    // dmg: "https://downloads.vectrontechnologies.com/RFTrueLink-latest.dmg",
    // exe: "https://downloads.vectrontechnologies.com/RFTrueLink-latest-x64.exe",
  };
  document.querySelectorAll(".rftl-page [data-download]").forEach((el) => {
    el.addEventListener("click", (e) => {
      const kind = el.dataset.download;
      const url = TRIAL_URLS[kind];
      if (url) { el.setAttribute("href", url); return; }
      e.preventDefault();
      window.location.href =
        "mailto:info@vectrontechnologies.com?subject=RFTrueLink%20trial%20download%20request";
    });
  });

  /* ---- Email form (stubbed until provider chosen) ---- */
  const form = document.querySelector(".rftl-page [data-email-form]");
  const status = document.querySelector(".rftl-page [data-email-status]");
  if (form && status) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const email = form.querySelector('input[name="email"]').value.trim();
      if (!email) return;
      status.textContent =
        "Thanks — we'll email " + email + " when there's something to share.";
      status.classList.remove("is-error");
      status.classList.add("is-success");
      form.reset();
    });
  }

  /* ---- Smooth in-page anchors only (don't intercept external links) ---- */
  document.querySelectorAll('.rftl-page a[href^="#"]').forEach((a) => {
    a.addEventListener("click", (e) => {
      const href = a.getAttribute("href");
      if (!href || href === "#") return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
})();
</script>

</BaseLayout>
