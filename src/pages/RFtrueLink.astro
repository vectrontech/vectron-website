---
import BaseLayout from "~/layouts/BaseLayout.astro";

const title = "RFTrueLink — RF link budgets without the Visio-and-Excel tax";
const description =
  "Desktop app for RF and antenna engineers. Build chains visually, see the link budget update in real time, export to xlsx. Offline-licensed. 14-day free trial. By Vectron Technologies LLC.";

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "RFTrueLink",
  applicationCategory: "EngineeringApplication",
  operatingSystem: "macOS, Windows",
  description,
  url: "https://vectrontechnologies.com/RFtrueLink/",
  publisher: {
    "@type": "Organization",
    name: "Vectron Technologies LLC",
    url: "https://vectrontechnologies.com",
  },
  offers: [
    {
      "@type": "Offer",
      name: "Personal",
      price: "50",
      priceCurrency: "USD",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "50",
        priceCurrency: "USD",
        billingIncrement: "P1M",
        unitText: "MONTH",
      },
    },
    {
      "@type": "Offer",
      name: "Enterprise",
      price: "2000",
      priceCurrency: "USD",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "2000",
        priceCurrency: "USD",
        billingIncrement: "P1Y",
        unitText: "ANNUAL",
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path="/RFtrueLink/"
  serviceJsonLd={productJsonLd}
>

<style is:global>
/* =====================================================================
   RFTrueLink subpage — all styles scoped under .rftl-page so they do
   not leak into the rest of the Vectron site.
   ===================================================================== */
.rftl-page {
  /* Palette */
  --c-bg-0: #060d1a;
  --c-bg-1: #0A1628;
  --c-bg-2: #11203a;
  --c-bg-3: #1A2744;
  --c-bg-elev: #142039;

  --c-line: rgba(255, 255, 255, 0.08);
  --c-line-strong: rgba(255, 255, 255, 0.16);

  --c-fg: #EAF0FA;
  --c-fg-mute: #A6B3CC;
  --c-fg-dim: #6F7D99;

  --c-accent: #F5A524;
  --c-accent-hi: #FFC15C;
  --c-accent-lo: #C77F0F;
  --c-accent-ink: #0A1628;

  --c-success: #36D49B;
  --c-danger: #FF7A7A;

  --ff-sans: -apple-system, BlinkMacSystemFont, "Inter Variable", "Inter",
             "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --ff-mono: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, Consolas, monospace;

  --fs-100: 0.78rem;
  --fs-200: 0.875rem;
  --fs-300: 1rem;
  --fs-400: 1.125rem;
  --fs-500: 1.375rem;
  --fs-600: 1.75rem;
  --fs-700: clamp(2rem, 3.2vw, 2.75rem);
  --fs-800: clamp(2.5rem, 4.8vw, 4rem);
  --fs-900: clamp(3rem, 6.4vw, 5.5rem);

  --sp-1: 0.25rem; --sp-2: 0.5rem; --sp-3: 0.75rem; --sp-4: 1rem;
  --sp-5: 1.5rem; --sp-6: 2rem; --sp-7: 3rem; --sp-8: 4rem;
  --sp-9: 6rem; --sp-10: 9rem;

  --r-sm: 6px; --r-md: 10px; --r-lg: 16px; --r-xl: 24px; --r-pill: 999px;

  --sh-1: 0 1px 2px rgba(0,0,0,0.4);
  --sh-2: 0 10px 30px rgba(0,0,0,0.35);
  --sh-3: 0 24px 60px rgba(0,0,0,0.5);
  --sh-glow-amber: 0 0 0 1px rgba(245,165,36,0.35), 0 12px 40px rgba(245,165,36,0.22);

  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  --dur-fast: 160ms;
  --dur-med: 280ms;
  --dur-slow: 520ms;

  --rftl-container-w: 1200px;
  --rftl-container-narrow-w: 760px;

  /* Page-level styles previously applied to <body> */
  font-family: var(--ff-sans);
  font-size: var(--fs-300);
  line-height: 1.55;
  color: var(--c-fg);
  background:
    radial-gradient(1200px 800px at 80% -10%, rgba(245,165,36,0.10), transparent 60%),
    radial-gradient(1000px 700px at 0% 30%, rgba(70,120,220,0.12), transparent 60%),
    linear-gradient(180deg, var(--c-bg-0) 0%, var(--c-bg-1) 20%, var(--c-bg-2) 60%, var(--c-bg-3) 100%);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: clip;
}

.rftl-page *, .rftl-page *::before, .rftl-page *::after { box-sizing: border-box; }
.rftl-page img, .rftl-page svg, .rftl-page video, .rftl-page canvas {
  display: block; max-width: 100%; height: auto;
}
.rftl-page button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
.rftl-page a { color: inherit; text-decoration: none; }
.rftl-page a:hover { color: var(--c-accent-hi); }
.rftl-page ul { padding-left: 1.1em; }
.rftl-page code, .rftl-page kbd, .rftl-page samp {
  font-family: var(--ff-mono); font-size: 0.92em;
}
.rftl-page ::selection { background: var(--c-accent); color: var(--c-accent-ink); }

.rftl-page h1, .rftl-page h2, .rftl-page h3, .rftl-page h4 {
  font-weight: 700; line-height: 1.08; letter-spacing: -0.02em;
  margin: 0 0 var(--sp-4); color: var(--c-fg);
  font-family: var(--ff-sans);
}
.rftl-page h1 { font-size: var(--fs-900); letter-spacing: -0.035em; }
.rftl-page h2 { font-size: var(--fs-800); letter-spacing: -0.025em; }
.rftl-page h3 { font-size: var(--fs-500); letter-spacing: -0.015em; }
.rftl-page p  { margin: 0 0 var(--sp-4); }
.rftl-page p:last-child { margin-bottom: 0; }

.rftl-page .lede { font-size: var(--fs-400); color: var(--c-fg); }
.rftl-page .eyebrow {
  text-transform: uppercase; letter-spacing: 0.14em;
  font-size: var(--fs-100); font-weight: 600;
  color: var(--c-accent); margin: 0 0 var(--sp-3);
  font-family: var(--ff-sans);
}
.rftl-page .accent { color: var(--c-accent); }
.rftl-page .text-center { text-align: center; }

.rftl-page .visually-hidden {
  position: absolute !important;
  width: 1px; height: 1px;
  margin: -1px; padding: 0; border: 0;
  clip: rect(0 0 0 0); clip-path: inset(50%);
  overflow: hidden; white-space: nowrap;
}

.rftl-page :focus-visible {
  outline: 2px solid var(--c-accent);
  outline-offset: 3px;
  border-radius: 4px;
}

/* ---- Containers, sections, grid ---- */
.rftl-page .container {
  width: min(100% - 2 * var(--sp-5), var(--rftl-container-w));
  margin-inline: auto;
}
.rftl-page .container--narrow {
  width: min(100% - 2 * var(--sp-5), var(--rftl-container-narrow-w));
  margin-inline: auto;
}
.rftl-page .section {
  padding-block: clamp(var(--sp-8), 9vw, var(--sp-10));
  position: relative;
}
.rftl-page .section--alt {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0)),
    rgba(255,255,255,0.02);
  border-block: 1px solid var(--c-line);
}
.rftl-page .section__header {
  text-align: center; max-width: 56ch; margin: 0 auto var(--sp-8);
}
.rftl-page .section__sub { color: var(--c-fg-mute); font-size: var(--fs-400); }

.rftl-page .grid { display: grid; gap: var(--sp-5); }
.rftl-page .grid--2 { grid-template-columns: 1fr; }
.rftl-page .grid--3 { grid-template-columns: 1fr; }
.rftl-page .grid--gap-lg { gap: var(--sp-6); }
.rftl-page .grid--gap-xl { gap: var(--sp-7); }
.rftl-page .align-center { align-items: center; }
@media (min-width: 760px) {
  .rftl-page .grid--2 { grid-template-columns: 1fr 1fr; }
  .rftl-page .grid--3 { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .rftl-page .grid--3 { grid-template-columns: repeat(3, 1fr); }
}

/* ---- Hero ---- */
.rftl-page .hero {
  position: relative;
  min-height: calc(100vh - 64px);
  min-height: calc(100svh - 64px);
  display: grid; align-items: center;
  padding: var(--sp-6) 0 var(--sp-8);
  overflow: clip; isolation: isolate;
}
.rftl-page .hero__bg {
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(900px 600px at 78% 20%, rgba(245,165,36,0.18), transparent 60%),
    radial-gradient(1100px 700px at 10% 80%, rgba(70,120,220,0.18), transparent 60%),
    linear-gradient(180deg, var(--c-bg-0) 0%, var(--c-bg-1) 45%, var(--c-bg-2) 100%);
  pointer-events: none;
}
.rftl-page .hero__canvas {
  position: absolute; inset: 0; width: 100%; height: 100%;
  z-index: 1; opacity: 0.9; pointer-events: none;
  -webkit-mask-image:
    linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%),
    linear-gradient(to right,  transparent 0%, rgba(0,0,0,0.55) 22%, #000 55%);
          mask-image:
    linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%),
    linear-gradient(to right,  transparent 0%, rgba(0,0,0,0.55) 22%, #000 55%);
  -webkit-mask-composite: source-in;
          mask-composite: intersect;
}
@media (max-width: 900px) { .rftl-page .hero__canvas { opacity: 0.6; } }

.rftl-page .hero__content {
  position: relative;
  width: min(100% - 2 * var(--sp-5), var(--rftl-container-w));
  margin-inline: auto; max-width: 720px;
  margin-right: auto;
  margin-left: max(var(--sp-5), calc((100vw - var(--rftl-container-w)) / 2));
  z-index: 2;
  will-change: transform;
}
.rftl-page .hero__eyebrow {
  text-transform: uppercase; letter-spacing: 0.16em;
  font-size: var(--fs-100); color: var(--c-fg-mute);
  margin: 0 0 var(--sp-5);
}
.rftl-page .hero__title { font-size: var(--fs-900); margin: 0 0 var(--sp-5); color: var(--c-fg); }
.rftl-page .hero__sub {
  font-size: var(--fs-400); color: var(--c-fg-mute);
  max-width: 52ch; margin: 0 0 var(--sp-6);
}
.rftl-page .hero__ctas {
  display: flex; flex-wrap: wrap;
  gap: var(--sp-3); margin-bottom: var(--sp-5);
}
.rftl-page .hero__meta { font-size: var(--fs-200); color: var(--c-fg-dim); margin: 0; }
.rftl-page .hero__scroll-cue {
  position: absolute; bottom: var(--sp-6); left: 50%;
  transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center;
  gap: var(--sp-2);
  color: var(--c-fg-dim); font-size: var(--fs-100);
  letter-spacing: 0.2em; text-transform: uppercase;
  z-index: 2;
}
.rftl-page .hero__scroll-line {
  width: 1px; height: 36px; display: block;
  background: linear-gradient(to bottom, var(--c-fg-dim), transparent);
}
@media (max-width: 900px) {
  .rftl-page .hero__content {
    margin-left: var(--sp-5);
    margin-right: var(--sp-5);
    width: auto;
  }
}

/* ---- Buttons (rftl- prefixed to avoid colliding with Vectron .btn) ---- */
.rftl-page .rftl-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: var(--sp-2);
  padding: 0.75rem 1.15rem;
  border-radius: var(--r-pill);
  font-weight: 600; font-size: var(--fs-200); letter-spacing: 0.01em;
  font-family: var(--ff-sans);
  transition: transform var(--dur-fast) var(--ease-out),
              background var(--dur-fast) var(--ease-out),
              box-shadow var(--dur-med) var(--ease-out),
              color var(--dur-fast) var(--ease-out);
  white-space: nowrap; border: 1px solid transparent; cursor: pointer;
  text-decoration: none;
}
.rftl-page .rftl-btn:hover { transform: translateY(-1px); }
.rftl-page .rftl-btn:active { transform: translateY(0); }
.rftl-page .rftl-btn--primary {
  background: linear-gradient(180deg, var(--c-accent-hi), var(--c-accent));
  color: var(--c-accent-ink);
  box-shadow: var(--sh-glow-amber);
}
.rftl-page .rftl-btn--primary:hover {
  color: var(--c-accent-ink);
  background: linear-gradient(180deg, var(--c-accent-hi), var(--c-accent-hi));
}
.rftl-page .rftl-btn--ghost {
  background: rgba(255,255,255,0.04);
  color: var(--c-fg);
  border-color: var(--c-line-strong);
}
.rftl-page .rftl-btn--ghost:hover { background: rgba(255,255,255,0.08); color: var(--c-fg); }
.rftl-page .rftl-btn--lg { padding: 0.95rem 1.4rem; font-size: var(--fs-300); }
.rftl-page .rftl-btn--xl { padding: 1.1rem 1.7rem; font-size: var(--fs-400); }
.rftl-page .rftl-btn--block { width: 100%; }

/* ---- Cards (feature cards) ---- */
.rftl-page .rftl-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.015));
  border: 1px solid var(--c-line);
  border-radius: var(--r-lg);
  padding: var(--sp-6);
  transition: transform var(--dur-med) var(--ease-out),
              border-color var(--dur-med) var(--ease-out),
              background var(--dur-med) var(--ease-out);
}
.rftl-page .rftl-card:hover {
  transform: translateY(-3px);
  border-color: var(--c-line-strong);
  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
}
.rftl-page .rftl-card__icon {
  display: inline-grid; place-items: center;
  width: 44px; height: 44px;
  border-radius: var(--r-md);
  background: rgba(245,165,36,0.12);
  border: 1px solid rgba(245,165,36,0.25);
  color: var(--c-accent); font-size: 1.25rem;
  margin-bottom: var(--sp-4);
}
.rftl-page .rftl-card h3 { margin-bottom: var(--sp-2); }
.rftl-page .rftl-card p { color: var(--c-fg-mute); font-size: var(--fs-200); margin: 0; }

/* ---- Pricing plans ---- */
.rftl-page .plan {
  position: relative;
  display: flex; flex-direction: column;
  background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.015));
  border: 1px solid var(--c-line);
  border-radius: var(--r-xl);
  padding: var(--sp-6);
  transition: transform var(--dur-med) var(--ease-out),
              border-color var(--dur-med) var(--ease-out);
}
.rftl-page .plan:hover { transform: translateY(-3px); border-color: var(--c-line-strong); }
.rftl-page .plan--featured {
  border-color: rgba(245,165,36,0.45);
  box-shadow: 0 24px 60px rgba(245,165,36,0.12),
              inset 0 0 0 1px rgba(245,165,36,0.18);
  background:
    linear-gradient(180deg, rgba(245,165,36,0.08), rgba(245,165,36,0.02)),
    linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.015));
}
.rftl-page .plan__badge {
  position: absolute; top: calc(-1 * var(--sp-3)); left: 50%;
  transform: translateX(-50%);
  background: var(--c-accent); color: var(--c-accent-ink);
  font-size: var(--fs-100); font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  padding: 0.3rem 0.7rem;
  border-radius: var(--r-pill);
  box-shadow: var(--sh-2);
}
.rftl-page .plan__head { margin-bottom: var(--sp-5); }
.rftl-page .plan__name { font-size: var(--fs-500); margin: 0 0 var(--sp-2); }
.rftl-page .plan__price {
  display: flex; align-items: baseline; gap: var(--sp-2);
  margin: 0 0 var(--sp-3);
}
.rftl-page .plan__price-amt {
  font-size: var(--fs-800); font-weight: 700;
  line-height: 1; letter-spacing: -0.03em;
}
.rftl-page .plan__price-unit { color: var(--c-fg-mute); font-size: var(--fs-300); }
.rftl-page .plan__for { color: var(--c-fg-mute); margin: 0; font-size: var(--fs-200); }
.rftl-page .plan__features {
  list-style: none; padding: 0;
  margin: 0 0 var(--sp-5);
  display: grid; gap: var(--sp-2);
  color: var(--c-fg-mute); font-size: var(--fs-200);
}
.rftl-page .plan__features li { position: relative; padding-left: 1.6em; }
.rftl-page .plan__features li::before {
  content: ""; position: absolute; left: 0; top: 0.55em;
  width: 0.9em; height: 0.9em; border-radius: 999px;
  background: radial-gradient(circle at 30% 30%, var(--c-accent-hi), var(--c-accent-lo));
  opacity: 0.85;
}
.rftl-page .plan__small {
  margin-top: auto; padding-top: var(--sp-4);
  color: var(--c-fg-dim); font-size: var(--fs-100);
}
.rftl-page .plan__small a { color: var(--c-accent-hi); }

/* ---- Tabs ---- */
.rftl-page .tabs__bar {
  display: flex; flex-wrap: wrap; gap: var(--sp-2);
  justify-content: center; margin-bottom: var(--sp-6);
  padding: 0.4rem; border-radius: var(--r-pill);
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--c-line);
  width: max-content; max-width: 100%;
  margin-inline: auto;
}
.rftl-page .tabs__tab {
  border-radius: var(--r-pill);
  padding: 0.55rem 1rem;
  color: var(--c-fg-mute); font-size: var(--fs-200); font-weight: 500;
  font-family: var(--ff-sans);
  transition: background var(--dur-fast) var(--ease-out),
              color var(--dur-fast) var(--ease-out);
}
.rftl-page .tabs__tab:hover { color: var(--c-fg); }
.rftl-page .tabs__tab.is-active,
.rftl-page .tabs__tab[aria-selected="true"] {
  background: var(--c-accent); color: var(--c-accent-ink);
}
.rftl-page .tabs__panel { display: none; }
.rftl-page .tabs__panel.is-active { display: block; }

/* ---- Screenshot frame ---- */
.rftl-page .shot-frame {
  border-radius: var(--r-lg); overflow: hidden;
  background: var(--c-bg-elev);
  border: 1px solid var(--c-line-strong);
  box-shadow: var(--sh-3);
}
.rftl-page .shot-frame__chrome {
  display: flex; gap: 6px; padding: 10px 14px;
  background: rgba(255,255,255,0.04);
  border-bottom: 1px solid var(--c-line);
}
.rftl-page .shot-frame__chrome span {
  width: 10px; height: 10px; border-radius: 999px;
  background: var(--c-fg-dim); opacity: 0.7;
}
.rftl-page .shot-frame__chrome span:nth-child(1) { background: #FF5F57; }
.rftl-page .shot-frame__chrome span:nth-child(2) { background: #FEBC2E; }
.rftl-page .shot-frame__chrome span:nth-child(3) { background: #28C840; }
.rftl-page .shot-frame__body { aspect-ratio: 16 / 10; }
.rftl-page .shot-frame__body--placeholder {
  display: grid; place-items: center;
  color: var(--c-fg-dim); font-size: var(--fs-200);
  background:
    repeating-linear-gradient(45deg,
      rgba(255,255,255,0.02) 0 12px,
      rgba(255,255,255,0) 12px 24px);
}

/* ---- Checklist ---- */
.rftl-page .checklist {
  list-style: none; padding: 0;
  margin: var(--sp-5) 0 0;
  display: grid; gap: var(--sp-2);
  color: var(--c-fg-mute);
}
.rftl-page .checklist li { position: relative; padding-left: 1.7em; }
.rftl-page .checklist li::before {
  content: "✓"; position: absolute; left: 0; top: 0;
  font-weight: 700; color: var(--c-accent);
}

/* ---- CTA banner ---- */
.rftl-page .cta-banner {
  padding-block: var(--sp-9);
  background:
    radial-gradient(900px 500px at 50% 0%, rgba(245,165,36,0.18), transparent 60%),
    linear-gradient(180deg, var(--c-bg-2), var(--c-bg-1));
  border-block: 1px solid var(--c-line);
}
.rftl-page .cta-banner__inner { display: grid; gap: var(--sp-6); align-items: center; }
.rftl-page .cta-banner h2 { margin-bottom: var(--sp-3); }
.rftl-page .cta-banner p { color: var(--c-fg-mute); max-width: 56ch; }
.rftl-page .cta-banner__buttons { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
@media (min-width: 900px) {
  .rftl-page .cta-banner__inner { grid-template-columns: 1.2fr 1fr; }
  .rftl-page .cta-banner__buttons { justify-content: flex-end; }
}

/* ---- Accordion ---- */
.rftl-page .accordion__item { border-bottom: 1px solid var(--c-line); }
.rftl-page .accordion__item:first-child { border-top: 1px solid var(--c-line); }
.rftl-page .accordion__item > summary {
  list-style: none; cursor: pointer;
  padding: var(--sp-5) 0;
  display: flex; align-items: center;
  justify-content: space-between; gap: var(--sp-4);
  font-weight: 600; font-size: var(--fs-400);
  color: var(--c-fg);
  transition: color var(--dur-fast) var(--ease-out);
}
.rftl-page .accordion__item > summary::-webkit-details-marker { display: none; }
.rftl-page .accordion__item > summary::after {
  content: "+";
  display: inline-grid; place-items: center;
  width: 28px; height: 28px;
  border-radius: 999px;
