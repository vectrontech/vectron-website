---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import CTASection from "~/components/CTASection.astro";

const title =
  "RF, Electromagnetics & EMI/EMC Consulting | Antenna Design | Vectron";
const description =
  "Senior RF engineering and electromagnetics consulting: antenna design, link budget analysis, EMC/EMI investigations, and HFSS, CST, FEKO simulation review. Project, retainer, or advisory engagements across the United States.";

const faqs = [
  {
    q: "What does Vectron's RF and electromagnetics consulting cover?",
    a: "Antenna design and integration, RF front-end design, link budget and propagation analysis, EMC/EMI investigations, and independent simulation or design review. We support concept through measurement, with HFSS, CST, FEKO, and ADS in routine use.",
  },
  {
    q: "Do you handle EMI/EMC investigations and compliance failures?",
    a: "Yes. We do root-cause analysis on emissions and susceptibility failures, design-for-EMC reviews, and physics-based mitigation, not symptom chasing. We engage either before a compliance test (to de-risk it) or after a fail (to identify and close the gap).",
  },
  {
    q: "How is RF consulting priced?",
    a: "Three engagement shapes: fixed-scope projects with defined deliverables and review cadence, monthly retainers for embedded senior engineering on an ongoing program, or hours-based advisory for short-form technical questions. Rates depend on scope; contact us for a quote.",
  },
  {
    q: "Which simulation tools do you use?",
    a: "HFSS, CST Microwave Studio, FEKO, and Keysight ADS in routine production use. We can also operate inside a client's existing tool stack and review simulations performed by your team independently.",
  },
  {
    q: "Where are you located and who do you serve?",
    a: "Vectron Technologies LLC is based in the United States and works with clients across the country. RF and electromagnetics engagements are typically remote with on-site visits as needed for measurement, lab, or design-review work.",
  },
  {
    q: "Can you do antenna design from scratch?",
    a: "Yes. Concept through measurement for printed, wire, and aperture antennas, including co-design with RF front-ends and the host platform. We deliver simulations, measured results, and integration guidance.",
  },
  {
    q: "Do you take engagements with NDA / ITAR / export-control constraints?",
    a: "We routinely work under NDA. ITAR and export-controlled work is evaluated case-by-case based on the specific program and counterparty controls in place.",
  },
];

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "RF, electromagnetics, and EMI/EMC consulting",
  provider: {
    "@type": "ProfessionalService",
    name: "Vectron Technologies",
    url: "https://vectrontechnologies.com",
  },
  serviceType: [
    "RF engineering consulting",
    "Electromagnetics consulting",
    "EMI consulting",
    "EMC consulting",
    "Antenna design",
    "Link budget analysis",
    "RF simulation review",
  ],
  description:
    "RF engineering and electromagnetics consulting. Antenna design and integration, link budget and propagation analysis, EMC/EMI investigations, and independent design or simulation review. Tools include HFSS, CST, FEKO, and ADS.",
  areaServed: { "@type": "Country", name: "United States" },
  url: "https://vectrontechnologies.com/services/rf-electromagnetics/",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "RF and electromagnetics offerings",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Antenna design and integration", description: "Printed, wire, and aperture antennas, simulated in HFSS, CST, FEKO and validated through measurement. Co-design with RF front-end and host platform." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "RF link budget and propagation analysis", description: "End-to-end link budgets for terrestrial, line-of-sight, and satellite links. Margin accounting that holds up to independent review." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "EMI / EMC investigations and design-for-EMC review", description: "Root-cause analysis on emissions and susceptibility failures. Physics-based mitigation. Design reviews ahead of compliance testing." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Independent RF simulation and design review", description: "Senior review of your team's RF simulations, designs, and test plans before a costly build commits." } },
    ],
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout title={title} description={description} path="/services/rf-electromagnetics/" ogImage="/images/generated/rf-hero.png" serviceJsonLd={serviceJsonLd}>
  <Hero
    eyebrow="RF / Electromagnetics"
    title="Senior RF consulting,"
    titleAccent="from antenna to system."
    subtitle="Antenna design, link-budget analysis, EMC/EMI investigations, simulation review. For teams that need a senior engineer in the room, not a slide deck about one."
    videoSrc="/brand/rf-hero-loop.mp4?v=2"
    primaryCta={{ href: "/contact/", label: "Discuss a program" }}
    secondaryCta={{ href: "#capabilities", label: "Capabilities" }}
  />

  <Section
    eyebrow="Practice"
    title="What we work on"
    lede="Vectron's RF practice exists for teams that need real engineering: the kind that gets reviewed, tested, and put into hardware that ships. This page does not talk about AI on purpose. RF buyers need a credible engineer, not a technology pitch."
  />

  <Section
    id="capabilities"
    tone="muted"
    eyebrow="Capabilities"
    title="Where we contribute"
  >
    <div class="grid gap-6 md:grid-cols-2">
      <div class="card p-8">
        <div class="eyebrow">Antenna & front-end</div>
        <h3 class="mt-3 font-display text-xl text-white">Antenna design & integration</h3>
        <p class="mt-3 text-[color:var(--color-muted)]">
          Concept through measurement for printed, wire, and aperture antennas. Co-design with RF front-ends and host platforms. HFSS, CST, FEKO.
        </p>
      </div>
      <div class="card p-8">
        <div class="eyebrow">Link & propagation</div>
        <h3 class="mt-3 font-display text-xl text-white">Link budgets & propagation</h3>
        <p class="mt-3 text-[color:var(--color-muted)]">
          End-to-end link analysis from datasheets or measured components. Terrestrial, line-of-sight, and satellite links. Margin accounting that holds up to review.
        </p>
      </div>
      <div class="card p-8">
        <div class="eyebrow">EMC / EMI</div>
        <h3 class="mt-3 font-display text-xl text-white">EMC / EMI investigations</h3>
        <p class="mt-3 text-[color:var(--color-muted)]">
          Root-cause analysis on emissions and susceptibility failures. Design-for-EMC reviews. Mitigation that addresses the physics, not the symptom.
        </p>
      </div>
      <div class="card p-8">
        <div class="eyebrow">Review</div>
        <h3 class="mt-3 font-display text-xl text-white">Simulation & design review</h3>
        <p class="mt-3 text-[color:var(--color-muted)]">
          Independent review of your team's RF simulations, designs, and test plans. A senior set of eyes before a costly build commits.
        </p>
      </div>
    </div>
  </Section>

  <Section
    eyebrow="Engagement"
    title="How we work"
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="card p-8">
        <div class="chrome-text font-display text-3xl font-semibold">Project</div>
        <p class="mt-3 text-sm text-[color:var(--color-muted)]">Fixed-scope engagement (design, analysis, or investigation) with defined deliverables and review cadence.</p>
      </div>
      <div class="card p-8">
        <div class="chrome-text font-display text-3xl font-semibold">Retainer</div>
        <p class="mt-3 text-sm text-[color:var(--color-muted)]">Embedded senior engineer on a monthly cadence. Design reviews, trade studies, and technical direction.</p>
      </div>
      <div class="card p-8">
        <div class="chrome-text font-display text-3xl font-semibold">Advisory</div>
        <p class="mt-3 text-sm text-[color:var(--color-muted)]">Short-form consulting for specific technical questions. Hours-based, no minimum.</p>
      </div>
    </div>
  </Section>

  <Section
    id="faq"
    eyebrow="FAQ"
    title="RF & electromagnetics consulting — common questions"
    lede="Quick answers to what RF and EMI/EMC consulting buyers usually ask first."
  >
    <div class="mx-auto max-w-3xl">
      {faqs.map((f) => (
        <details class="group border-b border-[color:var(--color-chrome-rule)] py-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-lg text-white">
            <span>{f.q}</span>
            <span class="text-[color:var(--color-chrome-dim)] transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[color:var(--color-muted)] leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <CTASection
    eyebrow="Next step"
    title="Describe your problem."
    subtitle="A 30-minute technical conversation. If we're the right fit, we'll scope a proposal. If we're not, we'll point you toward someone who is."
  />
</BaseLayout>
